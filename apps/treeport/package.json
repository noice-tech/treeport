{
  "name": "@treeport/treeport",
  "version": "0.6.1",
  "description": "A tree-first terminal driver for persistent development workspaces.",
  "type": "module",
  "bin": {
    "treeport": "bin/treeport.mjs"
  },
  "main": "dist/node/cli/index.js",
  "files": [
    "bin",
    "dist",
    "drizzle",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist dist-types",
    "build": "pnpm clean && pnpm build:node && pnpm build:web && pnpm check:package",
    "build:node": "tsdown",
    "build:web": "vite build",
    "prepack": "pnpm --dir=../.. exec turbo run build --filter=@treeport/treeport 1>&2",
    "check:package": "node scripts/check-package.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "dev": "node scripts/development.mjs",
    "dev:server": "rm -rf .treeport-dev-dist && TREEPORT_DATA_DIR=.treeport-dev/data TREEPORT_RUNTIME_DIR=.treeport-dev/runtime TREEPORT_DAEMON_LIFECYCLE=external tsdown --watch --out-dir .treeport-dev-dist",
    "start": "TREEPORT_WEB_DIST=dist/web node dist/node/server/index.js",
    "db:generate": "drizzle-kit generate",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc -b tsconfig.node.json --pretty",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --pretty"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noice-tech/treeport.git"
  },
  "bugs": {
    "url": "https://github.com/noice-tech/treeport/issues"
  },
  "homepage": "https://treeport.app",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@effect/opentelemetry": "^0.64.0",
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "@effect/rpc": "^0.76.2",
    "@libsql/client": "^0.17.4",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@playwright/cli": "0.1.18",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@treeport/panel-sdk": "workspace:*",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-serialize": "0.15.0-beta.301",
    "@xterm/headless": "6.1.0-beta.303",
    "cmdk": "^1.1.1",
    "commander": "14.0.3",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.1",
    "jsonc-parser": "^3.3.1",
    "node-pty": "1.2.0-beta.14",
    "playwright": "1.61.1",
    "vite": "8.1.5",
    "ws": "^8.21.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@treeport/shared": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "0.12.0-beta.301",
    "@xterm/addon-image": "0.10.0-beta.301",
    "@xterm/addon-web-links": "0.13.0-beta.301",
    "@xterm/xterm": "6.1.0-beta.304",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "catalog:",
    "tsdown": "0.22.14"
  }
}
