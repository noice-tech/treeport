{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/web/*"]
    },
    "composite": false,
    "noEmit": true
  },
  "include": [
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "e2e/**/*.ts",
    "vite.config.ts"
  ]
}
