{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "dist-types/node",
    "tsBuildInfoFile": "dist-types/node.tsbuildinfo"
  },
  "include": [
    "src/cli/**/*.ts",
    "src/server/**/*.ts",
    "src/duration.ts",
    "drizzle.config.ts",
    "tsdown.config.ts",
    "package.json"
  ],
  "references": [{ "path": "../../packages/shared" }]
}
