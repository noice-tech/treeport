{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "composite": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDir": "../..",
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/cli/**/*.ts",
    "src/server/**/*.ts",
    "src/server/**/*.json",
    "src/terminal-runtime/**/*.ts",
    "src/ghostty-vt/**/*.ts",
    "src/duration.ts",
    "drizzle.config.ts",
    "package.json"
  ]
}
