{
  "name": "@treeport/desktop",
  "version": "0.3.0",
  "private": true,
  "productName": "Treeport",
  "description": "A Tree-first desktop terminal driver for local and trusted private-network backends.",
  "author": "noice tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/noice-tech/treeport.git"
  },
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "node scripts/start.mjs",
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.shell-preload.config.ts && vite build --config vite.renderer.config.ts",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish:desktop": "electron-forge publish",
    "check:release": "node scripts/check-release.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "test": "pnpm build && pnpm test:desktop",
    "pretest:desktop": "install-electron",
    "test:desktop": "playwright test --config playwright.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/core": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/publisher-github": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "^4.2.1",
    "@electron/fuses": "^1.8.0",
    "@electron/notarize": "^3.1.1",
    "@fontsource-variable/inter": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@treeport/shared": "workspace:*",
    "@types/node": "^24.10.9",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "43.2.0",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "zod": "catalog:"
  },
  "dependencies": {
    "update-electron-app": "^3.3.0"
  }
}
