{
  "name": "@treeport/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "export TREEPORT_DATA_DIR=.treeport-dev/data TREEPORT_RUNTIME_DIR=.treeport-dev/runtime; if [ \"$TREEPORT_DIRECT_DEV\" = 1 ]; then tsdown --watch --on-success \"node --enable-source-maps dist/index.js\"; else portless api.treeport tsdown --watch --on-success \"node --enable-source-maps dist/index.js\"; fi",
    "build": "tsdown",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "@xterm/headless": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "effect": "^3.22.0",
    "hono": "^4.11.7",
    "jsonc-parser": "^3.3.1",
    "node-pty": "1.2.0-beta.14",
    "socket.io": "4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@treeport/shared": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "socket.io-client": "4.8.3",
    "tsdown": "0.22.14"
  }
}
