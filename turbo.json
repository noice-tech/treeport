{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["CI", "HOME", "PATH", "SHELL", "TMPDIR", "XDG_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-types/**"]
    },
    "@treeport/session-keeper#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false,
      "passThroughEnv": [
        "CARGO",
        "CARGO_HOME",
        "RUSTUP_HOME",
        "RUSTUP_TOOLCHAIN"
      ]
    },
    "@treeport/session-keeper#check:rust": {
      "cache": false,
      "passThroughEnv": [
        "CARGO",
        "CARGO_HOME",
        "RUSTUP_HOME",
        "RUSTUP_TOOLCHAIN"
      ]
    },
    "@treeport/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": [".vite/**"]
    },
    "@treeport/docs#build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["TREEPORT_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@treeport/treeport#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "//#knip": {
      "cache": false
    },
    "@treeport/pi#test:package": {
      "cache": false
    },
    "//#fmt:check": {
      "cache": false
    },
    "//#lint": {
      "cache": false
    },
    "//#test:unit": {
      "dependsOn": ["@treeport/shared#build", "@treeport/session-keeper#build"],
      "cache": false
    },
    "//#test:integration:run": {
      "dependsOn": ["@treeport/treeport#build"],
      "cache": false,
      "passThroughEnv": ["SESSION_KEEPER_DISK_FAULTS", "SESSION_KEEPER_STRESS"]
    }
  }
}
