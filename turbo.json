{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "HOME",
    "PATH",
    "SHELL",
    "TMPDIR",
    "TREEPORT_*",
    "XDG_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-types/**"]
    },
    "@treeport/treeport#build": {
      "dependsOn": [
        "@treeport/server#build",
        "@treeport/shared#build",
        "@treeport/web#build"
      ],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
