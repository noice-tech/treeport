# `pnpm start` defaults to 0.0.0.0 and generates a token when this is unset.
TASKTTY_HOST=0.0.0.0
TASKTTY_PORT=4780
# Set a stable token to avoid generating a new one on each network start.
TASKTTY_AUTH_TOKEN=1337
# Use TASKTTY_HOST=127.0.0.1 or `pnpm start:local` for loopback-only access.
# TASKTTY_DATABASE_PATH=~/.local/share/tasktty/tasktty.db
# TASKTTY_SHELL=/bin/zsh
# TASKTTY_TMUX_PATH=tmux
# TASKTTY_GIT_PATH=git
# TASKTTY_GH_PATH=gh
# TASKTTY_API_URL=http://127.0.0.1:4780
