# `pnpm start` defaults to 0.0.0.0 and generates a token when this is unset.
WTR_HOST=0.0.0.0
WTR_PORT=4780
# Set a stable token to avoid generating a new one on each network start.
WTR_AUTH_TOKEN=1337
# Use WTR_HOST=127.0.0.1 or `pnpm start:local` for loopback-only access.
# WTR_DATABASE_PATH=~/.local/share/wtr/wtr.db
# WTR_SHELL=/bin/zsh
# WTR_TMUX_PATH=tmux
# WTR_GIT_PATH=git
# WTR_GH_PATH=gh
# WTR_API_URL=http://127.0.0.1:4780
