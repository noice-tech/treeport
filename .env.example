# `pnpm start` defaults to 0.0.0.0. Authentication is temporarily disabled.
TREEPORT_HOST=0.0.0.0
TREEPORT_PORT=4780
# Use TREEPORT_HOST=127.0.0.1 or `pnpm start:local` to limit access to this machine.
# TREEPORT_DATABASE_PATH=~/.local/share/treeport/treeport.db
# TREEPORT_SHELL=/bin/zsh
# TREEPORT_TMUX_PATH=tmux
# TREEPORT_GIT_PATH=git
# TREEPORT_GH_PATH=gh
# TREEPORT_API_URL=http://127.0.0.1:4780

# Legacy TASKTTY_* variables remain accepted during the rename transition;
# TREEPORT_* takes precedence when both forms are set.
