{
  "name": "tasktty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tasktty/cli build && turbo run dev",
    "dev:desktop": "pnpm --parallel --filter @tasktty/web --filter @tasktty/desktop dev:desktop",
    "build": "turbo run build",
    "start": "node scripts/start.mjs",
    "start:local": "pnpm --filter @tasktty/server start",
    "test": "pnpm --filter @tasktty/cli build && vitest run",
    "test:desktop": "pnpm --filter @tasktty/desktop test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:real": "TASKTTY_REAL_INTEGRATION=1 vitest run --config vitest.real.config.ts",
    "test:web": "playwright test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "clean": "find apps packages -type d \\( -name dist -o -name dist-types \\) -prune -exec rm -rf {} + && rm -rf .turbo"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tasktty/cli": "workspace:*",
    "@types/node": "^24.10.9",
    "knip": "^6.29.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tsx": "^4.21.0",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@11.15.0"
}
