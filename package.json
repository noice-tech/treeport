{
  "name": "treeport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/development.mjs",
    "dev:direct": "TREEPORT_HOST=127.0.0.1 TREEPORT_PORT=4780 TREEPORT_API_URL=http://127.0.0.1:4780 TREEPORT_WEB_PORT=5173 TREEPORT_DESKTOP_URL=http://127.0.0.1:5173 turbo run dev",
    "dev:desktop": "pnpm --parallel --filter @treeport/web --filter @treeport/desktop dev:desktop",
    "dev:docs": "pnpm --filter @treeport/docs start",
    "build": "turbo run build",
    "start": "node scripts/start.mjs",
    "start:local": "pnpm --filter @treeport/server start",
    "test": "pnpm --filter @treeport/cli build && vitest run",
    "test:desktop": "pnpm --filter @treeport/desktop test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:real": "TREEPORT_REAL_INTEGRATION=1 vitest run --config vitest.real.config.ts",
    "test:web": "playwright test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "clean": "find apps packages -type d \\( -name dist -o -name dist-types \\) -prune -exec rm -rf {} + && rm -rf .turbo"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@treeport/cli": "workspace:*",
    "@types/node": "^24.10.9",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
    "knip": "^6.29.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tsx": "^4.21.0",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@11.15.0"
}
