{
  "name": "treeport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/development.mjs",
    "dev:cli": "node scripts/development-cli.mjs",
    "dev:tailscale": "node scripts/development.mjs --tailscale",
    "dev:direct": "TREEPORT_HOST=127.0.0.1 TREEPORT_PORT=8733 TREEPORT_API_URL=http://127.0.0.1:8733 TREEPORT_DESKTOP_URL=http://127.0.0.1:8733 turbo run dev",
    "dev:desktop": "pnpm dev",
    "dev:docs": "pnpm --filter @treeport/docs start",
    "build": "turbo run build",
    "check": "pnpm check:terminal-runtime && turbo run knip fmt:check lint typecheck check:rust test:unit test:integration:run test:package @treeport/docs#build @treeport/desktop#build --ui=stream",
    "ci:local": "bash scripts/ci-local.sh",
    "cli:install": "pnpm add -g link:$PWD/apps/treeport",
    "cli:uninstall": "pnpm remove -g @treeport/treeport",
    "signoff": "bash scripts/signoff.sh",
    "start": "node scripts/start.mjs",
    "sync": "git pull --ff-only",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "start:local": "pnpm --filter @treeport/treeport start",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "turbo run test:integration:run --ui=stream",
    "test:integration:run": "vitest run --config vitest.integration.config.ts",
    "check:terminal-runtime": "pnpm --filter @treeport/treeport check:terminal-runtime",
    "test:keeper:stress": "SESSION_KEEPER_STRESS=1 turbo run test:integration:run --ui=stream -- apps/treeport/src/terminal-runtime/rust-session.integration.test.ts",
    "measure:keeper": "pnpm --filter @treeport/session-keeper measure",
    "test:web": "playwright test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "fmt": "oxfmt && pnpm lint:fix",
    "fmt:check": "oxfmt --check",
    "clean": "find apps packages -type d \\( -name dist -o -name dist-types \\) -prune -exec rm -rf {} + && rm -rf apps/desktop/.vite .turbo"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@playwright/test": "^1.58.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@treeport/treeport": "workspace:*",
    "@types/node": "^24.10.9",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
    "knip": "^6.29.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.90.0",
    "oxc-resolver": "11.24.2",
    "turbo": "^2.10.5",
    "typescript": "catalog:",
    "vitest": "^4.0.18",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@12.11.2"
}
