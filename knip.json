{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["tailscale"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@treeport/treeport"]
    },
    "apps/desktop": {
      "entry": [
        "forge.config.ts",
        "src/main.ts",
        "src/preload.ts",
        "src/shell/shell.tsx"
      ],
      "paths": {
        "@treeport-web/*": ["../treeport/src/web/*"]
      },
      "ignoreDependencies": [
        "@electron-forge/maker-dmg",
        "@electron-forge/maker-zip"
      ],
      "ignoreBinaries": [
        "iconutil",
        "lipo",
        "plutil",
        "ditto",
        "hdiutil",
        "diff",
        "spctl"
      ]
    },
    "packages/web-panel-review": {
      "entry": ["web-panels/review/review.tsx"]
    },
    "packages/web-panel-files": {
      "entry": ["web-panels/files/files.tsx"]
    }
  }
}
