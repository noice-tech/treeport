{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["tailscale", "Xorg", "xrandr"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@treeport/treeport"]
    },
    "apps/treeport": {
      "entry": ["web/public/sw.js", "web/public/browser-latency-probe.js"],
      "ignoreDependencies": [
        "@effect/opentelemetry",
        "@opentelemetry/sdk-trace-base",
        "@opentelemetry/sdk-trace-node"
      ]
    },
    "apps/desktop": {
      "entry": [
        "forge.config.ts",
        "src/main.ts",
        "src/preload.ts",
        "src/shell/shell.tsx"
      ],
      "ignoreDependencies": [
        "@electron-forge/maker-dmg",
        "@electron-forge/maker-zip",
        "@electron-forge/publisher-github"
      ],
      "ignoreBinaries": ["iconutil", "lipo", "plutil"]
    },
    "packages/claude-code": {
      "entry": ["hooks/treeport.mjs"]
    },
    "packages/cursor": {
      "entry": ["bin/hook.mjs", "bin/status-worker.mjs"]
    },
    "packages/review": {
      "entry": ["web-apps/review/review.tsx"]
    },
    "packages/vscode": {
      "entry": ["web-apps/vscode/editor.ts"]
    }
  }
}
