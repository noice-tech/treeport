{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["tailscale"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@treeport/treeport"]
    },
    "apps/desktop": {
      "entry": [
        "forge.config.ts",
        "src/main.ts",
        "src/preload.ts",
        "src/shell/shell.tsx"
      ],
      "ignoreDependencies": [
        "@electron-forge/maker-dmg",
        "@electron-forge/maker-zip",
        "@electron-forge/publisher-github",
        "^@treeport-web/"
      ],
      "ignoreBinaries": ["lipo", "plutil"]
    },
    "packages/web-panel-review": {
      "entry": ["web-panels/review/review.tsx"]
    },
    "packages/web-panel-files": {
      "entry": ["web-panels/files/files.tsx"]
    }
  }
}
