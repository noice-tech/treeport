{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["tailscale", "Xorg", "xrandr", "pm2"],
  "ignoreIssues": {
    "tools/oxlint/anti-slop/vendor/**": ["types"]
  },
  "workspaces": {
    ".": {
      "entry": ["ecosystem.config.cjs"],
      "ignoreDependencies": ["@treeport/treeport"]
    },
    "apps/treeport": {
      "entry": [
        "web/public/sw.js",
        "web/public/browser-latency-probe.js",
        "src/server/daemon-log-worker.ts",
        "src/server/browser-relay.ts",
        "src/terminal-runtime/engine-worker.ts",
        "src/terminal-runtime/launcher.ts"
      ],
      "ignoreDependencies": [
        "@effect/opentelemetry",
        "@opentelemetry/sdk-trace-base",
        "@opentelemetry/sdk-trace-node"
      ]
    },
    "apps/desktop": {
      "entry": [
        "forge.config.ts",
        "src/main.ts",
        "src/preload.ts",
        "src/shell/shell.tsx"
      ],
      "ignoreDependencies": [
        "@electron-forge/maker-dmg",
        "@electron-forge/maker-zip"
      ],
      "ignoreBinaries": ["iconutil"]
    },
    "packages/claude-code": {
      "entry": ["hooks/treeport.mjs"]
    },
    "packages/cursor": {
      "entry": ["bin/hook.mjs", "bin/status-worker.mjs"]
    },
    "packages/github": {
      "entry": ["src/service.ts"]
    },
    "packages/review": {
      "entry": ["web-apps/review/review.tsx"]
    },
    "packages/vscode": {
      "entry": ["web-apps/vscode/editor.ts"]
    }
  }
}
