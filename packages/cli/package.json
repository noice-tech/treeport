{
  "name": "@treeport/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "treeport": "bin/treeport.mjs"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b && cp ../../skills/treeport/SKILL.md dist/treeport-skill.md && chmod +x bin/treeport.mjs dist/index.js",
    "dev": "pnpm build && tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty"
  },
  "dependencies": {
    "@treeport/shared": "workspace:*",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "socket.io": "4.8.3"
  }
}
