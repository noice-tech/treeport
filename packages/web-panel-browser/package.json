{
  "name": "@treeport/web-panel-browser",
  "version": "0.1.0",
  "description": "Treeport's Browser and Remote Browser web panel package.",
  "private": true,
  "type": "module",
  "keywords": [
    "treeport-package"
  ],
  "treeport": {
    "webPanels": [
      {
        "source": "./web-panels/browser",
        "permissions": [
          "same-origin"
        ]
      },
      {
        "source": "./web-panels/remote-browser",
        "permissions": [
          "host-browser"
        ]
      }
    ]
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit --pretty"
  },
  "devDependencies": {
    "@treeport/panel-sdk": "workspace:*",
    "typescript": "^7.0.2"
  }
}
