{
  "name": "@treeport/web-panel-files",
  "version": "0.1.0",
  "description": "Treeport's internal source-file editor web panel package.",
  "private": true,
  "type": "module",
  "keywords": [
    "treeport-package"
  ],
  "treeport": {
    "webPanels": [
      {
        "source": "./web-panels/files",
        "permissions": [
          "tree-files"
        ]
      },
      {
        "source": "./web-panels/editor",
        "sandbox": false
      }
    ],
    "services": {
      "code-server": {
        "scope": "instance",
        "executable": "code-server",
        "args": [
          "--config",
          "/dev/null",
          "--auth",
          "none",
          "--socket",
          "${socket}",
          "--socket-mode",
          "600",
          "--session-socket",
          "${socket}.session",
          "--user-data-dir",
          "${dataDir}/user",
          "--extensions-dir",
          "${dataDir}/extensions",
          "--disable-proxy",
          "--disable-telemetry",
          "--disable-update-check",
          "--disable-getting-started-override",
          "--ignore-last-opened"
        ],
        "readinessPath": "/healthz",
        "query": {
          "folder": "${treePath}"
        }
      }
    }
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit --pretty"
  },
  "dependencies": {
    "@pierre/diffs": "1.3.1",
    "@pierre/trees": "1.0.0-beta.6",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@treeport/panel-sdk": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
