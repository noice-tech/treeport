{
  "name": "@treeport/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./tracing": {
      "types": "./dist/tracing.d.ts",
      "default": "./dist/tracing.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty"
  },
  "devDependencies": {
    "@types/node": "^24.10.9"
  },
  "dependencies": {
    "@effect/opentelemetry": "^0.64.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@effect/platform": "^0.97.1",
    "@effect/rpc": "^0.76.2",
    "@treeport/panel-sdk": "workspace:*",
    "effect": "^3.22.1"
  }
}
