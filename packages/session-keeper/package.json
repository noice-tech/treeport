{
  "name": "@treeport/session-keeper",
  "version": "0.13.0",
  "description": "Native persistent PTY session owner for Treeport.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/protocol.js",
    "dist/protocol.d.ts",
    "dist/native",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm build:node && pnpm build:native && pnpm check:package",
    "build:node": "tsc -p tsconfig.json",
    "build:native": "node scripts/build-native.mjs",
    "measure": "node scripts/measure.mjs",
    "prepack": "pnpm build:node && pnpm check:package --all-targets",
    "check:package": "node scripts/check-package.mjs",
    "test:package": "node scripts/check-package.mjs --packed",
    "check:rust": "cargo fmt --check --manifest-path native/Cargo.toml && cargo clippy --locked --all-targets --manifest-path native/Cargo.toml -- -D warnings && cargo test --locked --manifest-path native/Cargo.toml",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noice-tech/treeport.git",
    "directory": "packages/session-keeper"
  },
  "bugs": {
    "url": "https://github.com/noice-tech/treeport/issues"
  },
  "homepage": "https://treeport.app",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "typescript": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
