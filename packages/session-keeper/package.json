{
  "name": "@treeport/session-keeper",
  "private": true,
  "version": "0.13.0",
  "description": "Native persistent PTY session owner for Treeport.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "pnpm build:native",
    "build:native": "cargo build --release --locked --manifest-path native/Cargo.toml --target-dir native/target",
    "measure": "node scripts/measure.mjs",
    "check:rust": "cargo fmt --check --manifest-path native/Cargo.toml && cargo clippy --locked --all-targets --manifest-path native/Cargo.toml -- -D warnings && cargo test --locked --manifest-path native/Cargo.toml",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noice-tech/treeport.git",
    "directory": "packages/session-keeper"
  },
  "bugs": {
    "url": "https://github.com/noice-tech/treeport/issues"
  },
  "homepage": "https://treeport.app",
  "devDependencies": {
    "@types/node": "^24.10.9",
    "typescript": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
