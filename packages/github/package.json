{
  "name": "@treeport/github",
  "private": true,
  "version": "0.13.0",
  "description": "GitHub pull request status on Treeport trees.",
  "type": "module",
  "keywords": [
    "treeport-package"
  ],
  "treeport": {
    "services": {
      "pull-requests": {
        "scope": "instance",
        "start": "always",
        "executable": "node",
        "args": [
          "${packageRoot}/src/service.ts"
        ]
      }
    }
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noice-tech/treeport.git",
    "directory": "packages/github"
  },
  "bugs": {
    "url": "https://github.com/noice-tech/treeport/issues"
  },
  "homepage": "https://treeport.app",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty"
  },
  "dependencies": {
    "@treeport/app-sdk": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "typescript": "catalog:"
  }
}
