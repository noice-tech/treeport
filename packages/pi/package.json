{
  "name": "@treeport/pi",
  "private": true,
  "version": "0.13.0",
  "description": "On-demand Treeport tools for Pi and codemode.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty",
    "test:package": "node scripts/check-package.mjs"
  },
  "keywords": [
    "pi-package",
    "treeport",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./extensions/treeport/index.ts"
    ],
    "skills": [
      "./skills/treeport"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noice-tech/treeport.git",
    "directory": "packages/pi"
  },
  "bugs": {
    "url": "https://github.com/noice-tech/treeport/issues"
  },
  "homepage": "https://treeport.app",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "typebox": "^1.3.27"
  }
}
